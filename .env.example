# --- Supabase (accounts, saving, publishing, multiplayer) ---------------------
# Project settings → API. Without these, games are saved in the browser only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Anthropic (AI generation) -------------------------------------------------
# Without it, Prefly runs in demo mode with built-in games.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: engineer effort (low | medium | high | xhigh | max). Higher = better games, slower.
# PREFLY_CODE_EFFORT=medium

# --- Prefly Pro payments (optional, Stripe) -----------------------------------
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ID=price_...            # a recurring monthly price
# STRIPE_WEBHOOK_SECRET=whsec_...      # webhook endpoint: https://your-site/api/billing/webhook
# SUPABASE_SERVICE_ROLE_KEY=...        # server only — lets the webhook record subscriptions
# NEXT_PUBLIC_PRO_PRICE=$12            # price shown on the pricing page
